# =============================================================
# COPIA ESTE ARCHIVO COMO .env Y COMPLETA LOS VALORES REALES
# NUNCA subas .env a GitHub — está en .gitignore
# =============================================================

# ──────────────────────────────────
# Base de datos (desarrollo local)
# ──────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=clinica_turnos
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres

# ──────────────────────────────────
# Railway (producción)
# Estas variables las inyecta Railway automáticamente
# cuando vinculas el servicio PostgreSQL al backend.
# Cópialas desde: Railway → servicio Postgres → Variables
# ──────────────────────────────────
# PGHOST=containers-us-west-xxx.railway.app
# PGPORT=5432
# PGDATABASE=railway
# PGUSER=postgres
# PGPASSWORD=<valor-generado-por-railway>

# ──────────────────────────────────
# Servidor
# ──────────────────────────────────
PORT=8080

# ──────────────────────────────────
# CORS — orígenes permitidos (separados por coma)
# ──────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://*.vercel.app

# ──────────────────────────────────
# Spring profile activo (prod activa application-prod.properties)
# ──────────────────────────────────
# SPRING_PROFILES_ACTIVE=prod
